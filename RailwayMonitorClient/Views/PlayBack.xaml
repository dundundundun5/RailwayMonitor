<hc:Window x:Class="RailwayMonitorClient.Views.PlayBack"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:hc="https://handyorg.github.io/handycontrol"
          xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
          xmlns:wfh="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
          Title="录像回放"
          Height="700"
          Width="1000"
          WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 设备选择区域 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="设备列表：" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="CmbDevices"
                      Width="300"
                      hc:InfoElement.Placeholder="auto"
                      IsEnabled="False"/>
            <TextBlock x:Name="TbLoginStatus"
                      VerticalAlignment="Center"
                      Margin="10,0,0,0"
                      Foreground="Gray"/>
        </StackPanel>

        <!-- 时间选择区域 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 开始时间 -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="开始时间：" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker Grid.Row="0" Grid.Column="1" x:Name="DpStartDate" Width="200" Margin="0,0,10,0"/>
            <hc:TimePicker Grid.Row="0" Grid.Column="2" x:Name="TpStartTime" Width="150"/>

            <!-- 结束时间 -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="结束时间：" VerticalAlignment="Center" Margin="0,5,5,0"/>
            <DatePicker Grid.Row="1" Grid.Column="1" x:Name="DpEndDate" Width="200" Margin="0,5,10,0"/>
            <hc:TimePicker Grid.Row="1" Grid.Column="2" x:Name="TpEndTime" Width="150" Margin="0,5,0,0"/>
        </Grid>

        <!-- 视频播放区域 -->
        <Border Grid.Row="2"
                Background="#1A202C"
                BorderBrush="#4A5568"
                BorderThickness="1"
                CornerRadius="4">
            <WindowsFormsHost>
                <wf:PictureBox x:Name="PictureBoxPlayback"
                              SizeMode="Zoom"
                              BackColor="LightGray"/>
            </WindowsFormsHost>
        </Border>

        <!-- 控制按钮区域 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" >
            <Button x:Name="BtnStartPlayback"
                    Content="开始回放"
                    Style="{StaticResource ButtonSuccess}"
                    Click="BtnStartPlayback_Click"
                    Margin="0,0,10,0"
                    Width="100"/>
            
            <Button x:Name="BtnPause"
                    Content="暂停"
                    Style="{StaticResource ButtonWarning}"
                    Click="BtnPause_Click"
                    Margin="0,0,10,0"
                    Width="100"
                    IsEnabled="False"/>
            <ComboBox x:Name="CmbPlay"
                      SelectionChanged="CmbPlay_OnSelectionChanged"
                      Width="100"
                      ItemsSource="{Binding PlaySpeed}"
                      Style="{StaticResource ComboBoxExtend}"
                      SelectedIndex="1"
                      IsEnabled="False"/>
           
            <Button x:Name="BtnStopPlayback"
                    Content="停止回放"
                    Style="{StaticResource ButtonDanger}"
                    Click="BtnStopPlayback_Click"
                    Margin="5,0,10,0"
                    Width="100"/>
            <Button x:Name="BtnClose"
                    Content="关闭"
                    Style="{StaticResource ButtonDefault}"
                    Click="BtnClose_Click"
                    Width="80" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</hc:Window>