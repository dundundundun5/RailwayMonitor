<hc:Window x:Class="RailwayMonitorClient.Views.DeviceEditWindow"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:hc="https://handyorg.github.io/handycontrol"
          Title="{Binding WindowTitle}"
          Height="500" 
          Width="400"
          WindowStartupLocation="CenterScreen">
    <!-- TODO: height 400-> 650  -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 表单区域 -->
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <!-- 设备名称 -->
            <StackPanel Orientation="Vertical">
                <TextBlock Text="设备名称" FontWeight="Bold" Margin="0,0,0,5"/>
                <hc:TextBox x:Name="TbDeviceName"
                           Text="{Binding SelectedDeviceName, Mode=TwoWay}"
                           hc:InfoElement.Placeholder="请输入设备名称"/>
            </StackPanel>

            <!-- 监控顺位 -->
            <StackPanel Orientation="Vertical">
                <TextBlock Text="监控顺位" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="CbDeviceIndex"
                         ItemsSource="{Binding DeviceIndexList}"
                         SelectedValue="{Binding SelectedDeviceIndex, Mode=TwoWay}"
                         SelectedIndex="0"/>
            </StackPanel>

            <!-- IP地址 -->
            <StackPanel Orientation="Vertical">
                <TextBlock Text="IP地址" FontWeight="Bold" Margin="0,0,0,5"/>
                <hc:TextBox x:Name="TbIp"
                           Text="{Binding DeviceIp, Mode=TwoWay}"
                           hc:InfoElement.Placeholder="请输入IP地址"/>
            </StackPanel>

            <!-- 端口 -->
            <StackPanel Orientation="Vertical">
                <TextBlock Text="端口" FontWeight="Bold" Margin="0,0,0,5"/>
                <hc:TextBox x:Name="TbPort"
                           Text="{Binding DevicePort, Mode=TwoWay}"
                           hc:InfoElement.Placeholder="请输入端口号"/>
            </StackPanel>

            <!-- 用户名 -->
            <StackPanel Orientation="Vertical">
                <TextBlock Text="用户名" FontWeight="Bold" Margin="0,0,0,5"/>
                <hc:TextBox x:Name="TbUsername"
                           Text="{Binding DeviceUsername, Mode=TwoWay}"
                           hc:InfoElement.Placeholder="请输入用户名"/>
            </StackPanel>

            <!-- 密码 -->
            <StackPanel Orientation="Vertical">
                <TextBlock Text="密码" FontWeight="Bold" Margin="0,0,0,5"/>
                <hc:PasswordBox x:Name="TbPassword" IsSafeEnabled="False"
                           UnsafePassword="{Binding DevicePassword, Mode=TwoWay}"
                           hc:InfoElement.Placeholder="请输入密码"/>
            </StackPanel>

            <!-- 设备类型 -->
            <StackPanel Orientation="Vertical">
                <TextBlock Text="设备类型" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="CbDeviceType"
                         ItemsSource="{Binding DeviceTypes}"
                         DisplayMemberPath="Name"
                         SelectedValuePath="Value"
                         SelectedValue="{Binding SelectedDeviceType, Mode=TwoWay}"/>
            </StackPanel>

            <!-- 通道 -->
            <StackPanel Orientation="Vertical">
                <TextBlock Text="通道" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="CbChannel"
                         ItemsSource="{Binding Channels}"
                         DisplayMemberPath="Name"
                         SelectedValuePath="Value"
                         SelectedValue="{Binding SelectedChannel, Mode=TwoWay}"/>
            </StackPanel>

            <!-- 测试连接按钮 -->
            <Button x:Name="BtnTestConnection"
                   Content="测试连接"
                   Style="{StaticResource ButtonInfo}"
                   Click="BtnTestConnection_Click"
                   Margin="0,10,0,0"/>
        </StackPanel>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnCancel"
                   Content="取消"
                   Style="{StaticResource ButtonDefault}"
                   Click="BtnCancel_Click"
                   Margin="0,0,10,0"/>

            <Button x:Name="BtnSave"
                   Content="保存"
                   Style="{StaticResource ButtonPrimary}"
                   Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</hc:Window>