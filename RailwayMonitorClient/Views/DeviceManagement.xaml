<hc:Window x:Class="RailwayMonitorClient.Views.DeviceManagement"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:hc="https://handyorg.github.io/handycontrol"
          xmlns:local="clr-namespace:RailwayMonitorClient.Views"
          xmlns:converters="clr-namespace:RailwayMonitorClient.Converters"
          Title="设备管理"
          Height="600"
          Width="1200"
          WindowStartupLocation="CenterScreen">

    <hc:Window.Resources>
        <converters:EnabledToStatusConverter x:Key="EnabledToStatusConverter"/>
        <converters:EnabledToBrushConverter x:Key="EnabledToBrushConverter"/>
        <converters:EnabledToStatusTextConverter x:Key="EnabledToStatusTextConverter"/>
        <converters:EnabledToButtonStyleConverter x:Key="EnabledToButtonStyleConverter"/>
        <converters:DeviceTypeConverter x:Key="DeviceTypeConverter"/>
    </hc:Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnAddDevice" Content="添加设备"
                    Style="{StaticResource ButtonPrimary}"
                    Click="BtnAddDevice_Click"
                    Margin="0,0,10,0"/>
            <Button x:Name="BtnRefresh" Content="刷新"
                    Style="{StaticResource ButtonDefault}"
                    Click="BtnRefresh_Click"
                    Margin="0,0,10,0"/>
            <TextBlock x:Name="TbStatus" VerticalAlignment="Center"
                      Foreground="Gray" FontSize="12"/>
        </StackPanel>

        <!-- 设备列表 -->
        <DataGrid x:Name="DgDevices"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  hc:DataGridAttach.ShowRowNumber="True">

            <DataGrid.Columns>
                <!-- 设备ID -->
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" Visibility="Collapsed"/>

                <!-- 设备名称 -->
                <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="监控顺位" Binding="{Binding Index}" Width="120"/>
                <!-- IP地址 -->
                <DataGridTextColumn Header="IP地址" Binding="{Binding Ip}" Width="120"/>

                <!-- 端口 -->
                <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60"/>

                <!-- 通道 -->
                <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="60"/>

                <!-- 设备类型 -->
                <DataGridTextColumn Header="设备类型" Binding="{Binding Type, Converter={StaticResource DeviceTypeConverter}}" Width="80"/>

                <!-- 状态 -->
                <DataGridTemplateColumn Header="状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Enabled, Converter={StaticResource EnabledToStatusConverter}}"
                                      Foreground="{Binding Enabled, Converter={StaticResource EnabledToBrushConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 创建时间 -->
                <DataGridTextColumn Header="创建时间" Binding="{Binding CreateDate, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>

                <!-- 操作列 -->
                <DataGridTemplateColumn Header="操作" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnEdit"
                                        Content="编辑"
                                        Style="{StaticResource ButtonWarning}"
                                        Click="BtnEdit_Click"
                                        Tag="{Binding Id}"
                                        Margin="0,0,5,0"
                                        Width="50"/>

                                <Button x:Name="BtnToggleStatus"
                                        Content="{Binding Enabled, Converter={StaticResource EnabledToStatusTextConverter}}"
                                        Style="{Binding Enabled, Converter={StaticResource EnabledToButtonStyleConverter}}"
                                        Click="BtnToggleStatus_Click"
                                        Tag="{Binding Id}"
                                        Margin="0,0,5,0"
                                        Width="60"/>

                                <Button x:Name="BtnDelete"
                                        Content="删除"
                                        Style="{StaticResource ButtonDanger}"
                                        Click="BtnDelete_Click"
                                        Tag="{Binding Id}"
                                        Width="50"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</hc:Window>