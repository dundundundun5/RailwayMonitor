<UserControl
    Background="#1E1E1E"
    Height="60"
    x:Class="RailwayMonitor.Views.AutoHideNavigationBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  系统标题  -->
        <TextBlock
            FontSize="18"
            FontWeight="Bold"
            Foreground="White"
            Grid.Column="0"
            Margin="20,0,0,0"
            Text="监控系统"
            VerticalAlignment="Center" />

        <!--  导航菜单  -->
        <StackPanel
            Grid.Column="1"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            VerticalAlignment="Center">

            <Button
                Click="BtnRealTimeMonitor_Click"
                Content="实时监控"
                Height="36"
                Margin="0,0,20,0"
                Style="{StaticResource ButtonCustom}"
                Visibility="Collapsed"
                Width="100"
                x:Name="BtnRealTimeMonitor" />

            <Button
                Click="BtnPlayback_Click"
                Content="录像回放"
                Height="36"
                Margin="0,0,20,0"
                Style="{StaticResource ButtonCustom}"
                Width="100"
                x:Name="BtnPlayback" />

            <Button
                Click="BtnDeviceManagement_Click"
                Content="设备管理"
                Height="36"
                Margin="0,0,20,0"
                Style="{StaticResource ButtonCustom}"
                Width="100"
                x:Name="BtnDeviceManagement" />

            <Button
                Click="BtnAlarmManagement_Click"
                Content="预警管理"
                Height="36"
                Margin="0,0,20,0"
                Style="{StaticResource ButtonCustom}"
                Width="100"
                x:Name="BtnAlarmManagement" />

            <Button
                Click="BtnRefreshMonitor_Click"
                Content="刷新监控"
                Height="36"
                IsEnabled="False"
                Style="{StaticResource ButtonCustom}"
                Width="100"
                x:Name="BtnRefreshMonitor" />

        </StackPanel>

        <!--  右侧功能区  -->
        <StackPanel
            Grid.Column="2"
            HorizontalAlignment="Right"
            Margin="0,0,20,0"
            Orientation="Horizontal"
            VerticalAlignment="Center">

            <Button
                Click="BtnSettings_Click"
                Content="测试弹窗"
                Height="36"
                Margin="0,0,10,0"
                Style="{StaticResource ButtonCustom}"
                Visibility="Collapsed"
                Width="60"
                x:Name="BtnSettings" />

            <Button
                Click="BtnMinimize_Click"
                Content="最小化"
                Height="36"
                Style="{StaticResource ButtonCustom}"
                Visibility="Collapsed"
                Width="60"
                x:Name="BtnMinimize" />

        </StackPanel>

    </Grid>

</UserControl>