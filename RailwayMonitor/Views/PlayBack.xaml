<hc:Window
    Height="700"
    Title="录像回放"
    Width="1000"
    WindowStartupLocation="CenterScreen"
    x:Class="RailwayMonitor.Views.PlayBack"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:RailwayMonitor.Views"
    xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
    xmlns:wfh="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  设备选择区域  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,10"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,10,0"
                Text="设备列表："
                VerticalAlignment="Center" />
            <ComboBox
                IsEnabled="True"
                Width="300"
                hc:InfoElement.Placeholder="auto"
                x:Name="CmbDevices" />
            <TextBlock
                Foreground="Gray"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                x:Name="TbLoginStatus" />
        </StackPanel>

        <!--  时间选择区域  -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  开始时间  -->
            <TextBlock
                Grid.Column="0"
                Grid.Row="0"
                Margin="0,0,5,0"
                Text="开始时间："
                VerticalAlignment="Center" />
            <DatePicker
                Grid.Column="1"
                Grid.Row="0"
                Margin="0,0,10,0"
                Width="200"
                x:Name="DpStartDate" />
            <hc:TimePicker
                Grid.Column="2"
                Grid.Row="0"
                Width="150"
                x:Name="TpStartTime" />

            <!--  结束时间  -->
            <TextBlock
                Grid.Column="0"
                Grid.Row="1"
                Margin="0,5,5,0"
                Text="结束时间："
                VerticalAlignment="Center" />
            <DatePicker
                Grid.Column="1"
                Grid.Row="1"
                Margin="0,5,10,0"
                Width="200"
                x:Name="DpEndDate" />
            <hc:TimePicker
                Grid.Column="2"
                Grid.Row="1"
                Margin="0,5,0,0"
                Width="150"
                x:Name="TpEndTime" />
        </Grid>

        <!--  视频播放区域  -->
        <Border
            Background="#1A202C"
            BorderBrush="#4A5568"
            BorderThickness="1"
            CornerRadius="4"
            Grid.Row="2">
            <WindowsFormsHost>
                <wf:PictureBox
                    BackColor="LightGray"
                    SizeMode="Zoom"
                    x:Name="PictureBoxPlayback" />
            </WindowsFormsHost>
        </Border>

        <!--  控制按钮区域  -->
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Center"
            Margin="0,10,0,0"
            Orientation="Horizontal">
            <Button
                Click="BtnStartPlayback_Click"
                Content="开始回放"
                Margin="0,0,10,0"
                Style="{StaticResource ButtonSuccess}"
                Width="100"
                x:Name="BtnStartPlayback" />

            <Button
                Click="BtnPause_Click"
                Content="暂停"
                IsEnabled="False"
                Margin="0,0,10,0"
                Style="{StaticResource ButtonWarning}"
                Width="100"
                x:Name="BtnPause" />
            <ComboBox
                IsEnabled="False"
                ItemsSource="{Binding PlaySpeed}"
                SelectedIndex="1"
                SelectionChanged="CmbPlay_OnSelectionChanged"
                Style="{StaticResource ComboBoxExtend}"
                Width="100"
                x:Name="CmbPlay" />

            <Button
                Click="BtnStopPlayback_Click"
                Content="停止回放"
                Margin="5,0,10,0"
                Style="{StaticResource ButtonDanger}"
                Width="100"
                x:Name="BtnStopPlayback" />
            <Button
                Click="BtnClose_Click"
                Content="关闭"
                Style="{StaticResource ButtonDefault}"
                Visibility="Collapsed"
                Width="80"
                x:Name="BtnClose" />
        </StackPanel>
    </Grid>
</hc:Window>