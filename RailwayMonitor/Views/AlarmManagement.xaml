<hc:Window x:Class="RailwayMonitor.Views.AlarmManagement"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:hc="https://handyorg.github.io/handycontrol"
          xmlns:converters="clr-namespace:RailwayMonitor.Converters"
          xmlns:local="clr-namespace:RailwayMonitor.Views"
          Title="预警管理"
          Height="700"
          Width="1200"
          WindowStartupLocation="CenterScreen">

    <hc:Window.Resources>
        <converters:AlarmTypeConverter x:Key="AlarmTypeConverter"/>
        <converters:ChannelToPointConverter x:Key="ChannelToPointConverter"/>
        <converters:AlarmStatusToVisibilityConverter x:Key="AlarmStatusToVisibilityConverter"/>
    </hc:Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnRefresh" Content="刷新"
                    Style="{StaticResource ButtonDefault}"
                    Click="BtnRefresh_Click"
                    Margin="0,0,10,0"/>
            <TextBlock x:Name="TbStatus" VerticalAlignment="Center"
                      Foreground="Gray" FontSize="12"/>
        </StackPanel>

        <!-- 预警列表 -->
        <DataGrid x:Name="DgAlarms"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  hc:DataGridAttach.ShowRowNumber="True">

            <DataGrid.Columns>
                <!-- ID -->
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" Visibility="Collapsed"/>

                <!-- 设备IP -->
                <DataGridTextColumn Header="设备IP" Binding="{Binding DeviceIp}" Width="150" Visibility="Collapsed"/>

                <!-- 通道 -->
                <DataGridTextColumn Header="预警设备" Binding="{Binding SuperBrainChannel, Converter={StaticResource ChannelToPointConverter}}" Width="80"/>

                <!-- 预警类型 -->
                <DataGridTextColumn Header="预警类型" Binding="{Binding AlarmType, Converter={StaticResource AlarmTypeConverter}}" Width="120"/>

                <!-- 预警时间 -->
                <DataGridTextColumn Header="预警时间" Binding="{Binding AlarmDate, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>

                <!-- 预警状态 -->
                <DataGridTextColumn Header="预警状态" Binding="{Binding AlarmStatusText}" Width="100"/>

                <!-- 操作列 -->
                <DataGridTemplateColumn Header="操作" Width="350">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- 处理状态下拉框 - 仅当AlarmStatus为未处理时显示 -->
                                <ComboBox x:Name="CmbAlarmStatus"
                                          Width="100"
                                          ItemsSource="{x:Static local:AlarmManagement.AlarmStatusList}"
                                         
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="CmbAlarmStatus_SelectionChanged"
                                          Margin="0,0,5,0"
                                          Visibility="{Binding AlarmStatus, Converter={StaticResource AlarmStatusToVisibilityConverter}}"/>

                                <!-- 处理按钮 - 仅当AlarmStatus为未处理时显示 -->
                                <Button x:Name="BtnHandle"
                                        Content="处理"
                                        Style="{StaticResource ButtonDanger}"
                                        Click="BtnHandle_Click"
                                        Tag="{Binding Id}"
                                        Margin="0,0,5,0"
                                        Width="60"
                                        IsEnabled="False"
                                        Visibility="{Binding AlarmStatus, Converter={StaticResource AlarmStatusToVisibilityConverter}}"/>

                                <!-- 查看详情按钮 -->
                                <Button x:Name="BtnViewDetail"
                                        Content="查看详情"
                                        Style="{StaticResource ButtonSuccess}"
                                        Click="BtnViewDetail_Click"
                                        Tag="{Binding}"
                                        Width="80"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分页控件 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="BtnFirstPage" Content="首页" Click="BtnFirstPage_Click" Style="{StaticResource ButtonDefault}" Margin="0,0,5,0"/>
            <Button x:Name="BtnPrevPage" Content="上一页" Click="BtnPrevPage_Click" Style="{StaticResource ButtonDefault}" Margin="0,0,5,0"/>
            <TextBlock x:Name="TbPageInfo" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <Button x:Name="BtnNextPage" Content="下一页" Click="BtnNextPage_Click" Style="{StaticResource ButtonDefault}" Margin="0,0,5,0"/>
            <Button x:Name="BtnLastPage" Content="末页" Click="BtnLastPage_Click" Style="{StaticResource ButtonDefault}"/>
        </StackPanel>
    </Grid>
</hc:Window>