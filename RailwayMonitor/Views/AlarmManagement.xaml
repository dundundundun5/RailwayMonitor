<hc:Window
    Height="700"
    Title="预警管理"
    Width="1200"
    WindowStartupLocation="CenterScreen"
    x:Class="RailwayMonitor.Views.AlarmManagement"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:converters="clr-namespace:RailwayMonitor.Converters"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:RailwayMonitor.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <hc:Window.Resources>
        <converters:AlarmTypeConverter x:Key="AlarmTypeConverter" />
        <converters:ChannelToPointConverter x:Key="ChannelToPointConverter" />
        <converters:AlarmStatusToVisibilityConverter x:Key="AlarmStatusToVisibilityConverter" />
    </hc:Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,10"
            Orientation="Horizontal">
            <Button
                Click="BtnRefresh_Click"
                Content="刷新"
                Margin="0,0,10,0"
                Style="{StaticResource ButtonDefault}"
                x:Name="BtnRefresh" />
            <TextBlock
                FontSize="12"
                Foreground="Gray"
                VerticalAlignment="Center"
                x:Name="TbStatus" />
        </StackPanel>

        <!--  预警列表  -->
        <DataGrid
            AutoGenerateColumns="False"
            Grid.Row="1"
            IsReadOnly="True"
            SelectionMode="Single"
            hc:DataGridAttach.ShowRowNumber="False"
            x:Name="DgAlarms">

            <DataGrid.Columns>
                <!--  预警时间  -->
                <DataGridTextColumn
                    Binding="{Binding AlarmDate, StringFormat=yyyy-MM-dd HH:mm:ss}"
                    Header="预警时间"
                    Width="160" />
                <!--  通道  -->
                <DataGridTextColumn
                    Binding="{Binding SuperBrainChannel, Converter={StaticResource ChannelToPointConverter}}"
                    Header="预警设备"
                    Width="80" />

                <!--  预警类型  -->
                <DataGridTextColumn
                    Binding="{Binding AlarmType, Converter={StaticResource AlarmTypeConverter}}"
                    Header="预警类型"
                    Width="120" />



                <!--  预警状态  -->
                <DataGridTextColumn
                    Binding="{Binding AlarmStatusText}"
                    Header="预警状态"
                    Width="100" />

                <!--  操作列  -->
                <DataGridTemplateColumn Header="操作" Width="350">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!--  处理状态下拉框 - 仅当AlarmStatus为未处理时显示  -->
                                <ComboBox
                                    DisplayMemberPath="Name"
                                    ItemsSource="{x:Static local:AlarmManagement.AlarmStatusList}"
                                    Margin="0,0,5,0"
                                    SelectedValuePath="Value"
                                    SelectionChanged="CmbAlarmStatus_SelectionChanged"
                                    Visibility="{Binding AlarmStatus, Converter={StaticResource AlarmStatusToVisibilityConverter}}"
                                    Width="100"
                                    x:Name="CmbAlarmStatus" />

                                <!--  处理按钮 - 仅当AlarmStatus为未处理时显示  -->
                                <Button
                                    Click="BtnHandle_Click"
                                    Content="处理"
                                    IsEnabled="False"
                                    Margin="0,0,5,0"
                                    Style="{StaticResource ButtonDanger}"
                                    Tag="{Binding Id}"
                                    Visibility="{Binding AlarmStatus, Converter={StaticResource AlarmStatusToVisibilityConverter}}"
                                    Width="60"
                                    x:Name="BtnHandle" />

                                <!--  查看详情按钮  -->
                                <Button
                                    Click="BtnViewDetail_Click"
                                    Content="查看详情"
                                    Style="{StaticResource ButtonSuccess}"
                                    Tag="{Binding}"
                                    Width="80"
                                    x:Name="BtnViewDetail" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!--  分页控件  -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            Margin="0,10,0,0"
            Orientation="Horizontal">
            <Button
                Click="BtnFirstPage_Click"
                Content="首页"
                Margin="0,0,5,0"
                Style="{StaticResource ButtonDefault}"
                x:Name="BtnFirstPage" />
            <Button
                Click="BtnPrevPage_Click"
                Content="上一页"
                Margin="0,0,5,0"
                Style="{StaticResource ButtonDefault}"
                x:Name="BtnPrevPage" />
            <TextBlock
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                x:Name="TbPageInfo" />
            <Button
                Click="BtnNextPage_Click"
                Content="下一页"
                Margin="0,0,5,0"
                Style="{StaticResource ButtonDefault}"
                x:Name="BtnNextPage" />
            <Button
                Click="BtnLastPage_Click"
                Content="末页"
                Style="{StaticResource ButtonDefault}"
                x:Name="BtnLastPage" />
        </StackPanel>
    </Grid>
</hc:Window>