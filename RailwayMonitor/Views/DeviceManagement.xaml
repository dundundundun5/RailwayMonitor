<hc:Window
    Height="600"
    Title="设备管理"
    Width="1200"
    WindowStartupLocation="CenterScreen"
    x:Class="RailwayMonitor.Views.DeviceManagement"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:converters="clr-namespace:RailwayMonitor.Converters"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <hc:Window.Resources>
        <converters:EnabledToStatusConverter x:Key="EnabledToStatusConverter" />
        <converters:EnabledToBrushConverter x:Key="EnabledToBrushConverter" />
        <converters:EnabledToStatusTextConverter x:Key="EnabledToStatusTextConverter" />
        <converters:EnabledToButtonStyleConverter x:Key="EnabledToButtonStyleConverter" />
        <converters:DeviceTypeConverter x:Key="DeviceTypeConverter" />
    </hc:Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,10"
            Orientation="Horizontal">
            <Button
                Click="BtnAddDevice_Click"
                Content="添加设备"
                Margin="0,0,10,0"
                Style="{StaticResource ButtonPrimary}"
                x:Name="BtnAddDevice" />
            <Button
                Click="BtnRefresh_Click"
                Content="刷新"
                Margin="0,0,10,0"
                Style="{StaticResource ButtonDefault}"
                x:Name="BtnRefresh" />
            <TextBlock
                FontSize="12"
                Foreground="Gray"
                VerticalAlignment="Center"
                x:Name="TbStatus" />
        </StackPanel>

        <!--  设备列表  -->
        <DataGrid
            AutoGenerateColumns="False"
            Grid.Row="1"
            IsReadOnly="True"
            SelectionMode="Single"
            hc:DataGridAttach.ShowRowNumber="False"
            x:Name="DgDevices">

            <DataGrid.Columns>
                <!--  设备名称  -->
                <DataGridTextColumn
                    Binding="{Binding Name}"
                    Header="设备名称"
                    Width="120" />
                <DataGridTextColumn
                    Binding="{Binding Index}"
                    Header="监控顺位"
                    Width="120" />
                <!--  IP地址  -->
                <DataGridTextColumn
                    Binding="{Binding Ip}"
                    Header="IP地址"
                    Width="120" />

                <!--  端口  -->
                <DataGridTextColumn
                    Binding="{Binding Port}"
                    Header="端口"
                    Width="60" />

                <!--  通道  -->
                <DataGridTextColumn
                    Binding="{Binding Channel}"
                    Header="通道"
                    Width="60" />

                <!--  设备类型  -->
                <DataGridTextColumn
                    Binding="{Binding Type, Converter={StaticResource DeviceTypeConverter}}"
                    Header="设备类型"
                    Width="80" />

                <!--  状态  -->
                <DataGridTemplateColumn Header="状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{Binding Enabled, Converter={StaticResource EnabledToBrushConverter}}" Text="{Binding Enabled, Converter={StaticResource EnabledToStatusConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  创建时间  -->
                <DataGridTextColumn
                    Binding="{Binding CreateDate, StringFormat=yyyy-MM-dd HH:mm:ss}"
                    Header="创建时间"
                    Width="160" />

                <!--  操作列  -->
                <DataGridTemplateColumn Header="操作" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Click="BtnEdit_Click"
                                    Content="编辑"
                                    Margin="0,0,5,0"
                                    Style="{StaticResource ButtonWarning}"
                                    Tag="{Binding Id}"
                                    Width="50"
                                    x:Name="BtnEdit" />

                                <Button
                                    Click="BtnToggleStatus_Click"
                                    Content="{Binding Enabled, Converter={StaticResource EnabledToStatusTextConverter}}"
                                    Margin="0,0,5,0"
                                    Style="{Binding Enabled, Converter={StaticResource EnabledToButtonStyleConverter}}"
                                    Tag="{Binding Id}"
                                    Width="60"
                                    x:Name="BtnToggleStatus" />

                                <Button
                                    Click="BtnDelete_Click"
                                    Content="删除"
                                    Style="{StaticResource ButtonDanger}"
                                    Tag="{Binding Id}"
                                    Width="50"
                                    x:Name="BtnDelete" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</hc:Window>