<hc:Window x:Class="RailwayMonitor.Views.AlarmDetailWindow"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:hc="https://handyorg.github.io/handycontrol"
          xmlns:converters="clr-namespace:RailwayMonitor.Converters"
          Title="预警详情"
          Height="600"
          Width="800"
          WindowStartupLocation="CenterOwner">

    <hc:Window.Resources>
        <converters:ChannelToPointConverter x:Key="ChannelToPointConverter"/>
        <converters:AlarmStatusToVisibilityConverter x:Key="AlarmStatusToVisibilityConverter"/>
    </hc:Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 基本信息 -->
        <GroupBox Grid.Row="0" Header="基本信息" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="点位：" Margin="5" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SuperBrainChannel, Converter={StaticResource ChannelToPointConverter}}" Margin="5" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="预警类型：" Margin="5" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding AlarmType}" Margin="5" VerticalAlignment="Center"/>

                <!-- 第二行 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="预警时间：" Margin="5" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AlarmDate, StringFormat=yyyy-MM-dd HH:mm:ss}" Margin="5" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="预警状态：" Margin="5" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding AlarmStatusText}" Margin="5" VerticalAlignment="Center"/>

                <!-- 第三行：处理控件 - 仅当AlarmStatus为未处理时显示 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="处理状态：" Margin="5" VerticalAlignment="Center"
                          Visibility="{Binding AlarmStatus, Converter={StaticResource AlarmStatusToVisibilityConverter}}"/>
                <ComboBox Grid.Row="2" Grid.Column="1"
                         x:Name="CmbAlarmStatus"
                         Width="120"
                         ItemsSource="{Binding AlarmStatusList}"
                         SelectedValue="{Binding SelectedAlarmStatus}"
                         SelectedValuePath="Value"
                         DisplayMemberPath="Name"
                         Margin="5"
                         Visibility="{Binding AlarmStatus, Converter={StaticResource AlarmStatusToVisibilityConverter}}"/>
                <Button Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                        x:Name="BtnHandle"
                        Content="处理"
                        Style="{StaticResource ButtonDanger}"
                        Click="BtnHandle_Click"
                        Width="80"
                        Margin="5"
                        HorizontalAlignment="Left"
                        Visibility="{Binding AlarmStatus, Converter={StaticResource AlarmStatusToVisibilityConverter}}"/>
            </Grid>
        </GroupBox>

        <!-- 图片预览 -->
        <GroupBox Grid.Row="1" Header="图片预览" Margin="0,0,0,10">
            <Grid>
                <Image x:Name="ImgDetail"
                       Source="{Binding DisplayImagePath}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MaxWidth="700"
                       MaxHeight="400"/>
            </Grid>
        </GroupBox>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnClose" Content="关闭"
                    Style="{StaticResource ButtonDefault}"
                    Click="BtnClose_Click"
                    Width="80"/>
        </StackPanel>
    </Grid>
</hc:Window>