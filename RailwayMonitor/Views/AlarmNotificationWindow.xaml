<hc:Window
    AllowsTransparency="True"
    Background="Transparent"
    Height="400"
    ShowInTaskbar="False"
    Title="告警通知"
    Topmost="True"
    Width="500"
    WindowStyle="None"
    x:Class="RailwayMonitor.Views.AlarmNotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:converters="clr-namespace:RailwayMonitor.Converters"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <hc:Window.Resources>
        <converters:AlarmTypeConverter x:Key="AlarmTypeConverter" />
        <converters:AlarmStatusToVisibilityConverter x:Key="AlarmStatusToVisibilityConverter" />
    </hc:Window.Resources>

    <Border
        Background="#FFF5F5F5"
        BorderBrush="#FFCC0000"
        BorderThickness="2"
        CornerRadius="8"
        Margin="5">

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题栏  -->
            <Border
                Background="#FFCC0000"
                CornerRadius="8,8,0,0"
                Grid.Row="0"
                Margin="-15,-15,-15,10">
                <StackPanel Margin="15,8" Orientation="Horizontal">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="🚨 安全告警" />
                    <TextBlock
                        FontSize="14"
                        Foreground="White"
                        Margin="15,0,0,0"
                        Text="60s"
                        VerticalAlignment="Center"
                        x:Name="TbTimer" />
                </StackPanel>
            </Border>

            <!--  内容区域 - 图片为主要显示  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  大图片预览  -->
                <Border
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="6"
                    Grid.Column="0"
                    Margin="0,0,15,0">
                    <Image
                        HorizontalAlignment="Center"
                        Source="{Binding DisplayImagePath}"
                        Stretch="Uniform"
                        VerticalAlignment="Center"
                        x:Name="ImgAlarm" />
                </Border>

                <!--  告警信息 - 右侧信息栏  -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Vertical"
                    Width="100">
                    <!--  告警类型  -->
                    <Border
                        Background="#FFF0F0F0"
                        CornerRadius="4"
                        Margin="0,0,0,10"
                        Padding="10,8">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                FontSize="12"
                                Foreground="#666666"
                                Margin="0,0,0,2"
                                Text="告警类型" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#CC0000"
                                Text="{Binding AlarmType, Converter={StaticResource AlarmTypeConverter}}"
                                x:Name="TbAlarmType" />
                        </StackPanel>
                    </Border>

                    <!--  设备信息  -->
                    <Border
                        Background="#FFF0F0F0"
                        CornerRadius="4"
                        Margin="0,0,0,10"
                        Padding="10,8">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                FontSize="12"
                                Foreground="#666666"
                                Margin="0,0,0,2"
                                Text="设备信息" />
                            <TextBlock
                                FontSize="14"
                                Foreground="#333333"
                                Text="{Binding DeviceInfo}"
                                TextWrapping="Wrap"
                                x:Name="TbDeviceInfo" />
                        </StackPanel>
                    </Border>

                    <!--  告警时间  -->
                    <Border
                        Background="#FFF0F0F0"
                        CornerRadius="4"
                        Padding="10,8">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                FontSize="12"
                                Foreground="#666666"
                                Margin="0,0,0,2"
                                Text="告警时间" />
                            <TextBlock
                                FontSize="14"
                                Foreground="#333333"
                                Text="{Binding AlarmTime}"
                                TextWrapping="Wrap"
                                x:Name="TbAlarmTime" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!--  操作按钮  -->
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Orientation="Horizontal">
                <!--  处理状态下拉框 - 仅当AlarmStatus为未处理时显示  -->
                <ComboBox
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding AlarmStatusList}"
                    Margin="0,0,5,0"
                    SelectedValue="{Binding SelectedAlarmStatus}"
                    SelectedValuePath="Value"
                    Visibility="{Binding AlarmStatus, Converter={StaticResource AlarmStatusToVisibilityConverter}}"
                    Width="100"
                    x:Name="CmbAlarmStatus" />

                <!--  处理按钮 - 仅当AlarmStatus为未处理时显示  -->
                <Button
                    Click="BtnHandle_Click"
                    Content="处理"
                    FontSize="14"
                    Height="35"
                    Margin="0,0,10,0"
                    Style="{StaticResource ButtonDanger}"
                    Visibility="{Binding AlarmStatus, Converter={StaticResource AlarmStatusToVisibilityConverter}}"
                    Width="60"
                    x:Name="BtnHandle" />

                <Button
                    Click="BtnViewDetail_Click"
                    Content="查看详情"
                    FontSize="14"
                    Height="35"
                    Margin="0,0,10,0"
                    Style="{StaticResource ButtonPrimary}"
                    Width="100"
                    x:Name="BtnViewDetail" />

                <Button
                    Click="BtnClose_Click"
                    Content="关闭"
                    FontSize="14"
                    Height="35"
                    Style="{StaticResource ButtonDefault}"
                    Width="80"
                    x:Name="BtnClose" />
            </StackPanel>
        </Grid>
    </Border>
</hc:Window>