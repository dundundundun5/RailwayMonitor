<hc:Window x:Class="RailwayMonitor.Views.AlarmNotificationWindow"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:hc="https://handyorg.github.io/handycontrol"
          xmlns:converters="clr-namespace:RailwayMonitor.Converters"
          Title="告警通知"
          Height="400"
          Width="400"
          WindowStyle="None"
          AllowsTransparency="True"
          Background="Transparent"
          ShowInTaskbar="False"
          Topmost="True">

    <hc:Window.Resources>
        <converters:AlarmTypeConverter x:Key="AlarmTypeConverter"/>
        <converters:AlarmStatusToVisibilityConverter x:Key="AlarmStatusToVisibilityConverter"/>
    </hc:Window.Resources>

    <Border Background="#FFF5F5F5"
            BorderBrush="#FFCC0000"
            BorderThickness="2"
            CornerRadius="8"
            Margin="5">

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#FFCC0000" CornerRadius="8,8,0,0" Margin="-15,-15,-15,10">
                <StackPanel Orientation="Horizontal" Margin="15,8">
                    <TextBlock Text="🚨 安全告警"
                              Foreground="White"
                              FontWeight="Bold"
                              FontSize="18"/>
                    <TextBlock x:Name="TbTimer"
                              Text="60s"
                              Foreground="White"
                              FontSize="14"
                              Margin="15,0,0,0"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 内容区域 - 图片为主要显示 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 大图片预览 -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,15,0">
                    <Image x:Name="ImgAlarm"
                           Source="{Binding DisplayImagePath}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <!-- 告警信息 - 右侧信息栏 -->
                <StackPanel Grid.Column="1" Orientation="Vertical" Width="100">
                    <!-- 告警类型 -->
                    <Border Background="#FFF0F0F0" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="告警类型"
                                      FontSize="12"
                                      Foreground="#666666"
                                      Margin="0,0,0,2"/>
                            <TextBlock x:Name="TbAlarmType"
                                      Text="{Binding AlarmType, Converter={StaticResource AlarmTypeConverter}}"
                                      FontWeight="Bold"
                                      FontSize="16"
                                      Foreground="#CC0000"/>
                        </StackPanel>
                    </Border>

                    <!-- 设备信息 -->
                    <Border Background="#FFF0F0F0" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="设备信息"
                                      FontSize="12"
                                      Foreground="#666666"
                                      Margin="0,0,0,2"/>
                            <TextBlock x:Name="TbDeviceInfo"
                                      Text="{Binding DeviceInfo}"
                                      FontSize="14"
                                      Foreground="#333333"
                                      TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 告警时间 -->
                    <Border Background="#FFF0F0F0" CornerRadius="4" Padding="10,8">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="告警时间"
                                      FontSize="12"
                                      Foreground="#666666"
                                      Margin="0,0,0,2"/>
                            <TextBlock x:Name="TbAlarmTime"
                                      Text="{Binding AlarmTime}"
                                      FontSize="14"
                                      Foreground="#333333"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 操作按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <!-- 处理状态下拉框 - 仅当AlarmStatus为未处理时显示 -->
                <ComboBox x:Name="CmbAlarmStatus"
                          Width="100"
                          ItemsSource="{Binding AlarmStatusList}"
                          SelectedValue="{Binding SelectedAlarmStatus}"
                          SelectedValuePath="Value"
                          DisplayMemberPath="Name"
                          Margin="0,0,5,0"
                          Visibility="{Binding AlarmStatus, Converter={StaticResource AlarmStatusToVisibilityConverter}}"/>

                <!-- 处理按钮 - 仅当AlarmStatus为未处理时显示 -->
                <Button x:Name="BtnHandle"
                        Content="处理"
                        Style="{StaticResource ButtonDanger}"
                        Click="BtnHandle_Click"
                        Margin="0,0,10,0"
                        Width="60"
                        Height="35"
                        FontSize="14"
                        Visibility="{Binding AlarmStatus, Converter={StaticResource AlarmStatusToVisibilityConverter}}"/>

                <Button x:Name="BtnViewDetail"
                        Content="查看详情"
                        Style="{StaticResource ButtonPrimary}"
                        Click="BtnViewDetail_Click"
                        Width="100"
                        Height="35"
                        FontSize="14"
                        Margin="0,0,10,0"/>

                <Button x:Name="BtnClose"
                        Content="关闭"
                        Style="{StaticResource ButtonDefault}"
                        Click="BtnClose_Click"
                        Width="80"
                        Height="35"
                        FontSize="14"/>
            </StackPanel>
        </Grid>
    </Border>
</hc:Window>